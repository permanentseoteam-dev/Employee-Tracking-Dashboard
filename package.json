{
  "name": "employee-tracking-dashboard",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/start-all.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare:agent": "node scripts/prepare-agent-bundle.mjs",
    "agent:ensure": "node scripts/ensure-agent.mjs",
    "build:agent": "cargo build --release --manifest-path employee-agent/Cargo.toml --target-dir target-employee-agent",
    "build:desktop": "node scripts/build-desktop-signed.mjs",
    "release:desktop": "node scripts/publish-github-release.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.2",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.2",
    "@types/node": "^22.8.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
