PROJECT_NAME="Employee Tracking Platform"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL in production, or SQLite for local dev)
DATABASE_URL="sqlite+aiosqlite:///./tracking.db"
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/tracking_db"

# Storage Configuration
STORAGE_TYPE="local"
LOCAL_STORAGE_DIR="./storage/screenshots"
# S3_ENDPOINT_URL="https://s3.amazonaws.com"
# S3_ACCESS_KEY="your-s3-access-key"
# S3_SECRET_KEY="your-s3-secret-key"
# S3_BUCKET_NAME="employee-screenshots"
