{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Employee Tracking App",
  "version": "0.1.4",
  "identifier": "com.employeetracking.agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:agent && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Employee Tracking App",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/agent/employee-agent.exe": "agent/employee-agent.exe",
      "resources/agent/agent-manifest.json": "agent/agent-manifest.json",
      "resources/agent/agent.env.template": "agent/agent.env.template"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/agent-installer-hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzOTlGMENDQTcyNjU4RTMKUldUaldDYW56UENaVS9rYU5mdUhmcTVnd1JacHJmNnNELzZXd1lpUW53QXZZM0ZMNEVOcU9CQWcK",
      "endpoints": [
        "https://github.com/permanentseoteam-dev/Employee-Tracking-Dashboard/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
