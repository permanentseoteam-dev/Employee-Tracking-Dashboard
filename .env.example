# Supabase Project Configuration
# Replace these with your actual Project URL and Anon Public Key from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: also used by employee-agent when run from repo root
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key-here
# EMPLOYEE_ID=cccccccc-cccc-cccc-cccc-cccccccccccc
# OFFICE_HOURS_ENABLED=true
# WORK_START=09:00
# WORK_END=17:00
# WORK_DAYS=mon,tue,wed,thu,fri
# CAPTURE_OUTSIDE_HOURS=false
